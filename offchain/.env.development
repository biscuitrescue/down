# Development Environment Configuration for Oilseed Value Chain Backend

# ======================== SERVER CONFIGURATION ========================
RUST_LOG=debug
RUST_BACKTRACE=full
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# ======================== IPFS CONFIGURATION ========================

# Development IPFS Service (Local Mock Server)
IPFS_API_URL=http://127.0.0.1:5001
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# Backup IPFS Service (Optional for development)
IPFS_BACKUP_API_URL=
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Gateway Configuration
IPFS_GATEWAY_URL=http://127.0.0.1:5001/ipfs/

# Performance Settings (relaxed for development)
IPFS_TIMEOUT_SECONDS=60
IPFS_MAX_FILE_SIZE_MB=50
IPFS_RETRY_ATTEMPTS=2

# ======================== BLOCKCHAIN CONFIGURATION ========================

# Local Development Network (Anvil/Ganache)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3

# Development Private Keys (Test keys only - safe to commit)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# ======================== DATABASE CONFIGURATION ========================

# SQLite for development (simpler setup)
DATABASE_URL=sqlite:./dev.db

# Redis for caching (optional in development)
REDIS_URL=redis://127.0.0.1:6379

# ======================== SECURITY CONFIGURATION ========================

# JWT Configuration (development keys)
JWT_SECRET=dev_jwt_secret_not_for_production
JWT_EXPIRATION=86400

# API Keys for external services (development/test keys)
API_KEY_SECRET=dev_api_key_secret

# CORS Configuration (permissive for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ======================== MONITORING & OBSERVABILITY ========================

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Health Check
HEALTH_CHECK_ENABLED=true

# Tracing (optional in development)
JAEGER_ENDPOINT=http://127.0.0.1:14268/api/traces
OTEL_EXPORTER_JAEGER_ENABLED=false

# ======================== EXTERNAL SERVICES ========================

# SMS/Email Notifications (disabled in development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=

# Weather API (optional test key)
OPENWEATHER_API_KEY=your_test_openweather_key

# Satellite Imagery (optional test credentials)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ======================== BACKUP & RECOVERY ========================

# Local storage for development backups
S3_BUCKET=dev-oilseed-backups
S3_ACCESS_KEY=dev_access_key
S3_SECRET_KEY=dev_secret_key
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1

# ======================== SUPPLY CHAIN SPECIFIC ========================

# Quality Standards (relaxed for testing)
DEFAULT_QUALITY_THRESHOLD=6.0
FRAUD_DETECTION_THRESHOLD=3.0

# Geofencing for logistics (larger tolerance for testing)
GEOFENCE_TOLERANCE_METERS=1000

# IoT Device Configuration (local MQTT broker)
IOT_BROKER_URL=mqtt://127.0.0.1:1883
IOT_USERNAME=dev_user
IOT_PASSWORD=dev_password

# ======================== COMPLIANCE & REGULATORY ========================

# Mock API endpoints for development
FSSAI_API_URL=http://127.0.0.1:8001/mock/fssai
FSSAI_API_KEY=dev_fssai_key

DGFT_API_URL=http://127.0.0.1:8001/mock/dgft
DGFT_API_KEY=dev_dgft_key

# ======================== PERFORMANCE TUNING ========================

# Connection Pooling (smaller for development)
DATABASE_MAX_CONNECTIONS=5
DATABASE_MIN_CONNECTIONS=2
DATABASE_TIMEOUT_SECONDS=10

# HTTP Client Configuration
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=2
HTTP_RETRY_DELAY_SECONDS=1

# Caching (smaller cache for development)
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE_MB=64

# ======================== DEVELOPMENT SPECIFIC SETTINGS ========================

# Enable mock services for faster development
DEV_MOCK_IPFS=true
DEV_MOCK_BLOCKCHAIN=false
DEV_SKIP_VERIFICATION=true

# Development helper endpoints
DEV_ENABLE_DEBUG_ENDPOINTS=true
DEV_ENABLE_MOCK_DATA=true
DEV_AUTO_MIGRATE=true

# Hot reload settings
DEV_WATCH_FILES=true
DEV_AUTO_RESTART=true

# Seed data for development
DEV_LOAD_SEED_DATA=true
DEV_SEED_FARMERS=10
DEV_SEED_BATCHES=5

# Development ports for additional services
DEV_MOCK_IPFS_PORT=5001
DEV_MOCK_BLOCKCHAIN_PORT=8545
DEV_METRICS_PORT=9090
DEV_DOCS_PORT=8080

# Feature flags for development
FEATURE_AI_SCORING=true
FEATURE_IOT_INTEGRATION=true
FEATURE_SATELLITE_IMAGERY=false
FEATURE_BLOCKCHAIN_EVENTS=true
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_EMAIL_NOTIFICATIONS=false

# Development logging
DEV_LOG_SQL_QUERIES=true
DEV_LOG_HTTP_REQUESTS=true
DEV_LOG_IPFS_OPERATIONS=true
DEV_LOG_BLOCKCHAIN_CALLS=true
