# OilsChain backend configuration. Copy to backend/.env (gitignored) and fill in.
# scripts/dev-stack.sh generates a working local file in .devstack/backend.env automatically.

# ---- Server ----
ENVIRONMENT=development          # development | production | test
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=oilschain.db       # SQLite operation journal + application index
FRONTEND_DIR=../frontend         # optional: serve the web UI from this directory
CORS_ALLOWED_ORIGINS=            # production only; comma-separated. Empty = same-origin only

# ---- Chain (EVM) ----
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337                   # required; startup fails if the RPC reports a different chain
# Either point at the Foundry deployment file...
DEPLOYMENT_FILE=../contracts/deployments/31337.json
# ...or set the addresses explicitly (these win over the file):
# REGISTRY_ADDRESS=0x...         # OilseedValueChain (legacy name CONTRACT_ADDRESS is accepted)
# PROVENANCE_NFT_ADDRESS=0x...
# CREDENTIAL_NFT_ADDRESS=0x...
DEPLOY_BLOCK=0                   # first block to scan for events
ADMIN_PRIVATE_KEY=               # must hold ROLE_ADMIN (the deployer). Never commit a real key.
PARTICIPANT_FUNDING_WEI=0        # gas money sent to each new participant wallet (0 = fund manually)
TX_CONFIRM_TIMEOUT_SECS=30       # how long a request waits before answering 202 "submitted"
TX_POLL_INTERVAL_MS=500
TX_DROP_AFTER_SECS=600           # unknown to the node this long after submit => resend

# ---- IPFS (Kubo-compatible HTTP API) ----
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080/ipfs/
IPFS_AUTH_HEADER=                # e.g. "Bearer <token>" for a hosted Kubo-compatible API
# IPFS_PROJECT_ID= / IPFS_PROJECT_SECRET=   # legacy basic-auth pair, used if IPFS_AUTH_HEADER is unset
IPFS_TIMEOUT_SECS=15
IPFS_MAX_RETRIES=3

# ---- IPFS backup pinning (optional; every stored block is replicated and verified) ----
# IPFS_BACKUP_KUBO_URLS=http://backup-node:5001            # comma-separated Kubo-compatible APIs
# IPFS_BACKUP_KUBO_AUTH_HEADER=                            # Authorization header for those nodes
# IPFS_PINNING_SERVICE_URL=https://api.pinata.cloud/psa    # IPFS Pinning Service API endpoint
# IPFS_PINNING_SERVICE_TOKEN=                              # bearer token (JWT) for that service
IPFS_BACKUP_MAX_ATTEMPTS=8

# ---- Secrets (generate with: openssl rand -hex 32) ----
ADMIN_API_TOKEN=                 # >= 32 chars; bearer token for admin endpoints
KEY_ENCRYPTION_KEY=              # 32-byte hex; seals custodial participant wallet keys in SQLite
PII_ENCRYPTION_KEY=              # 32-byte hex; encrypts confidential records before IPFS upload (must differ)

# ---- Background reconciler ----
RECONCILE_INTERVAL_SECS=15
AI_AUTO_REVEAL=true              # reveal committed AI assessments once the 1h window opens

# ---- Rankings ----
RANKING_PRIOR_STRENGTH=4         # pseudo-observations of the population prior (docs/RANKING.md)

# ---- Offline advisory (optional, local model only) ----
# ADVISORY_BASE_URL=http://127.0.0.1:11434   # Ollama on this machine/LAN; unset = endpoint returns 503
ADVISORY_MODEL=gemma3n:e2b
ADVISORY_LANGUAGES=en            # subset of: en,hi,mr,te,ta,gu
ADVISORY_TIMEOUT_SECS=120
